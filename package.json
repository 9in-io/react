{
  "name": "@9in-io/react",
  "version": "0.1.0",
  "description": "Official 9in SDK for React: <NineProvider>, useNine(), <SignedIn>, <SignedOut> and <RequireAuth>, built on @9in-io/sdk (sign-in with PKCE, token refresh).",
  "license": "MIT",
  "homepage": "https://9in.io/docs/single-page-apps/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/9in-io/react.git"
  },
  "bugs": {
    "url": "https://github.com/9in-io/react/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@9in/source": "./src/index.tsx",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "react",
    "oauth",
    "oidc",
    "openid-connect",
    "authentication",
    "pkce",
    "9in"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@9in-io/sdk": "^0.3.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
